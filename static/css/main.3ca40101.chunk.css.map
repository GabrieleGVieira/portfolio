.App {
  text-align: center;
}

.App-logo {
  animation: App-logo-spin infinite 20s linear;
  height: 40vmin;
  pointer-events: none;
}

.App-header {
  background-color: #282c34;
  min-height: 100vh;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  font-size: calc(10px + 2vmin);
  color: white;
}

.App-link {
  color: #61dafb;
}

@keyframes App-logo-spin {
  from {
    transform: rotate(0deg);
  }
  to {
    transform: rotate(360deg);
  }
}

.about-cta {
  margin-bottom: 22px !important;
}

.about-cta .btn {
  padding: 5px 16px !important;
  font-size: 11px;
  font-weight: 300;
  letter-spacing: 0.5px;
  border-radius: 20px;
}

.about-cta .btn i {
  font-size: 11px;
  margin-left: 6px;
}

.about-cta .btn-primary.btn-outline {
  border-width: 1px;
}

.about-cta .btn-primary:not(.btn-outline) {
  border-width: 1px;
}

.services .icon .anticon {
  display: table-cell;
  vertical-align: middle;
  font-size: 34px;
  color: #fff;
}

.services.color-2 {
  border-bottom-color: #d9a596 !important;
}
.services.color-2 .icon {
  background: #d9a596 !important;
}
.services.color-2 .icon:before {
  border-color: transparent transparent #d9a596 transparent !important;
}
.services.color-2 .icon:after {
  border-color: #d9a596 transparent transparent transparent !important;
}

.services.color-6 {
  border-bottom-color: #8c9fb8 !important;
}
.services.color-6 .icon {
  background: #8c9fb8 !important;
}
.services.color-6 .icon:before {
  border-color: transparent transparent #8c9fb8 transparent !important;
}
.services.color-6 .icon:after {
  border-color: #8c9fb8 transparent transparent transparent !important;
}

.project-case-list {
  margin-top: 2em;
}

.project-case {
  margin-bottom: 4em;
  align-items: center;
}

.project-case__media-col {
  margin-bottom: 1.5em;
}

.project-case__media {
  background-size: cover;
  background-position: center center;
  background-repeat: no-repeat;
  border-radius: 4px;
  min-height: 220px;
  height: 100%;
  box-shadow: 0 10px 30px rgba(0, 0, 0, 0.12);
}

.project-case__body h3 {
  font-size: 18px;
  font-weight: 700;
  text-transform: uppercase;
  letter-spacing: 2px;
  margin-bottom: 6px;
}

.project-case__description {
  color: #999999;
  font-size: 14px;
  margin-bottom: 1.5em !important;
}

.project-case__body .heading-meta {
  margin-bottom: 6px;
}

.project-case__body p {
  margin-bottom: 1.2em;
}

.project-case__stack {
  margin-bottom: 1.5em !important;
}

.tag-chip {
  display: inline-block;
  background: rgba(160, 186, 161, 0.15);
  color: #7a9c7c;
  font-size: 11px;
  letter-spacing: 0.5px;
  padding: 4px 12px;
  border-radius: 20px;
  margin: 0 6px 6px 0;
}

.project-case__links .btn {
  padding: 5px 16px !important;
  font-size: 11px;
  font-weight: 300;
  letter-spacing: 0.5px;
  border-radius: 20px;
}

.project-case__links .btn i {
  font-size: 11px;
  margin-left: 6px;
}

.other-projects {
  margin-top: 1em;
  padding-top: 2em;
  border-top: 1px solid rgba(0, 0, 0, 0.08);
}

.other-projects__list {
  list-style: none;
  padding: 0;
  margin: 1em 0 0;
}

.other-projects__list li {
  padding: 14px 0;
  border-bottom: 1px solid rgba(0, 0, 0, 0.08);
}

.other-projects__list a {
  display: flex;
  align-items: center;
  justify-content: space-between;
  color: rgba(0, 0, 0, 0.85);
}

.other-projects__title {
  font-size: 15px;
  font-weight: 500;
}

.other-projects__list a i {
  font-size: 12px;
  color: #a0baa1;
  transition: 0.3s;
}

.other-projects__list a:hover .other-projects__title {
  color: #2c98f0;
}

.other-projects__list a:hover i {
  transform: translateX(4px);
}

.other-projects__list p {
  margin: 4px 0 0;
  font-size: 13px;
  color: #999999;
}
